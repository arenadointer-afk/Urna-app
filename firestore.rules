rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidCandidate(candidate) {
      return candidate is map &&
        candidate.keys().hasAll(['id', 'number', 'name']) &&
        candidate.id is string && candidate.id.size() <= 32 &&
        candidate.number is string && candidate.number.size() <= 20 &&
        candidate.name is string && candidate.name.size() <= 200 &&
        (!('photoUrl' in candidate) || (candidate.photoUrl is string && candidate.photoUrl.size() <= 1000000)) &&
        (!('role' in candidate) || (candidate.role is string && candidate.role.size() <= 100)) &&
        (!('party' in candidate) || (candidate.party is string && candidate.party.size() <= 100));
    }

    function isValidGameState(data) {
      return data is map &&
        (!('roundNumber' in data) || (data.roundNumber is number && data.roundNumber >= 1)) &&
        (!('roundDuration' in data) || (data.roundDuration is number && data.roundDuration >= 5)) &&
        (!('timeLeft' in data) || (data.timeLeft is number && data.timeLeft >= 0)) &&
        (!('isPaused' in data) || data.isPaused is bool) &&
        (!('leftPoints' in data) || (data.leftPoints is number && data.leftPoints >= 0)) &&
        (!('rightPoints' in data) || (data.rightPoints is number && data.rightPoints >= 0)) &&
        (!('leftCandidate' in data) || isValidCandidate(data.leftCandidate)) &&
        (!('rightCandidate' in data) || isValidCandidate(data.rightCandidate));
    }

    function isValidLiveEvent(data) {
      return data is map &&
        data.keys().hasAll(['id', 'type', 'timestamp']) &&
        data.id is string && data.id.size() <= 64 &&
        data.type is string && data.type.size() <= 32 &&
        (!('clientId' in data) || (data.clientId is string && data.clientId.size() <= 64)) &&
        data.timestamp is number;
    }

    function isValidChatMessage(data) {
      return data is map &&
        data.keys().hasAll(['id', 'username', 'text', 'timestamp']) &&
        data.id is string && data.id.size() <= 64 &&
        data.username is string && data.username.size() <= 100 &&
        data.text is string && data.text.size() <= 300 &&
        data.timestamp is number;
    }

    // Game state: Public read so any spectator, mobile device, or OBS overlay can track the battle without login
    match /game_state/{stateId} {
      allow get, list: if isValidId(stateId);
      allow create, update: if isValidId(stateId) && isValidGameState(request.resource.data);
      allow delete: if false;
    }

    // Real-time battle events (votes, gifts, ticks)
    match /live_events/{eventId} {
      allow get, list: if true;
      allow create: if isValidId(eventId) && isValidLiveEvent(request.resource.data);
      allow update, delete: if false;
    }

    // Live chat messages
    match /chat_messages/{messageId} {
      allow get, list: if true;
      allow create: if isValidId(messageId) && isValidChatMessage(request.resource.data);
      allow update, delete: if false;
    }
  }
}
